[Unit]
Description=Student Flask Frontend Service
After=network.target

[Service]
User=ubuntu
# 1. Point to your project directory
WorkingDirectory=/home/ubuntu/Tutedude/DevOps/Jenkins_CICD_Sani_Rajesh_Lokhande/backend

# 2. Tell systemd to read your local .env file
EnvironmentFile=/home/ubuntu/Tutedude/DevOps/Jenkins_CICD_Sani_Rajesh_Lokhande/backend/.env

# 3. Use the absolute path to the Python binary INSIDE your venv
ExecStart=/home/ubuntu/Tutedude/DevOps/Jenkins_CICD_Sani_Rajesh_Lokhande/backend/.venv/bin/python  student_app.py

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
